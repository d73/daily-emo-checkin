{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-emo-checkin",
  "main": "src/worker/index.ts",
  // Builds the app before every deploy, so a plain `npx wrangler deploy` works
  // (including in Cloudflare's GitHub builds).
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-emo-checkin",
      // Replace with the id printed by: npx wrangler d1 create daily-emo-checkin
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_MODEL": "claude-sonnet-5-5"
  },
  "observability": { "enabled": true }
}
